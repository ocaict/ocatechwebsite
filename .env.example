# ============================================================
# OCATECH Digital Solutions - Environment Variables Configuration
# ============================================================
# NOTE: Set these environment variables as encrypted Secrets in
# Cloudflare Pages Dashboard -> Settings -> Environment variables
# DO NOT commit real API keys into this repository!
# ============================================================

# 1. Groq API Key (Free tier from https://console.groq.com)
# Used by /functions/api/chat.js for Llama 3.1 AI chatbot
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Resend API Key (Free tier from https://resend.com)
# Used by /functions/api/contact.js to deliver visitor inquiries by email
RESEND_API_KEY=re_your_resend_api_key_here

# 3. Notification Email Receiver
# Email address where student applications and inquiries should be sent
CONTACT_EMAIL_TO=[EMAIL_ADDRESS]

# 4. Optional: Custom Sender Email for Resend (defaults to onboarding@resend.dev on free tier)
# CONTACT_EMAIL_FROM=OCATECH Admissions <onboarding@resend.dev>
